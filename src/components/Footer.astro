---
/**
 * Footer Component
 */
const currentYear = new Date().getFullYear();
---

<footer class="footer">
  <div class="container footer-container">
    <div class="footer-left">
      <a href="#hero" class="footer-logo">&lt;Fazril.M /&gt;</a>
      <p class="copyright-text">
        &copy; {currentYear} Fazril Mantovani. All rights reserved.
      </p>
    </div>

    <div class="footer-right">
      <a 
        href="${import.meta.env.BASE_URL}CV/CV_Fazril_Mantovani.pdf" 
        target="_blank" 
        download="CV_Fazril_Mantovani.pdf" 
        class="footer-link"
      >
        Unduh CV (PDF)
      </a>
      <span class="footer-sep">•</span>
      <a href="https://github.com/Fazril210" target="_blank" rel="noopener" class="footer-link">GitHub</a>
      <span class="footer-sep">•</span>
      <a href="https://www.linkedin.com/in/fazrilmv/" target="_blank" rel="noopener" class="footer-link">LinkedIn</a>
    </div>
  </div>
</footer>

<style>
  .footer {
    padding: 40px 0;
    background-color: var(--bg-dark);
    border-top: 1px solid var(--border-subtle);
  }

  .footer-container {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 20px;
  }

  .footer-logo {
    font-family: var(--font-mono);
    font-weight: 700;
    color: var(--text-primary);
    text-decoration: none;
    font-size: 1rem;
  }

  .copyright-text {
    font-size: 0.8125rem;
    color: var(--text-muted);
    margin-top: 4px;
  }

  .footer-right {
    display: flex;
    align-items: center;
    gap: 12px;
    font-size: 0.85rem;
  }

  .footer-link {
    color: var(--text-secondary);
    text-decoration: none;
    transition: var(--transition-fast);
  }

  .footer-link:hover {
    color: var(--accent-cyan);
  }

  .footer-sep {
    color: var(--text-muted);
  }

  @media (max-width: 640px) {
    .footer-container {
      flex-direction: column;
      text-align: center;
    }
  }
</style>
