---
/**
 * Contact Component
 * Direct channels for connecting with Fazril Mantovani, social profiles, and CV download CTA.
 */
---

<section class="contact-section" id="kontak">
  <div class="container">
    <div class="contact-card reveal">
      <div class="contact-content text-center">
        <span class="section-label-tag">05 / LETS CONNECT</span>
        <h2 class="contact-heading">Siap Berkolaborasi & Mengembangkan Solusi Digital</h2>
        <p class="contact-subtext">
          Apakah Anda membutuhkan Full Stack Developer untuk proyek web/mobile, integrasi sistem, atau ingin mendiskusikan peluang kerja? Jangan ragu untuk terhubung!
        </p>

        <div class="contact-actions">
          <button class="social-button email-btn" id="copyEmailBtn" title="Klik untuk menyalin alamat email">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
              <polyline points="22,6 12,13 2,6"></polyline>
            </svg>
            <span id="emailBtnText">Salin Alamat Email</span>
          </button>

          <a
            href="https://github.com/Fazril210"
            target="_blank"
            rel="noopener noreferrer"
            class="social-button github-btn"
          >
            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
              <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
            </svg>
            <span>GitHub (Fazril210)</span>
          </a>

          <a
            href="https://www.linkedin.com/in/fazrilmv/"
            target="_blank"
            rel="noopener noreferrer"
            class="social-button linkedin-btn"
          >
            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
              <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
            </svg>
            <span>LinkedIn (fazrilmv)</span>
          </a>

          <a
            href="${import.meta.env.BASE_URL}CV/CV_Fazril_Mantovani.pdf"
            target="_blank"
            download="CV_Fazril_Mantovani.pdf"
            class="social-button cv-highlight-btn"
          >
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
              <polyline points="7 10 12 15 17 10"></polyline>
              <line x1="12" y1="15" x2="12" y2="3"></line>
            </svg>
            <span>Unduh Resume (PDF)</span>
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  const copyBtn = document.getElementById("copyEmailBtn");
  const btnText = document.getElementById("emailBtnText");
  const email = "fazril.mantovani@gmail.com";

  copyBtn?.addEventListener("click", () => {
    navigator.clipboard.writeText(email).then(() => {
      if (btnText) {
        btnText.textContent = "Email Tersalin! ✓";
        setTimeout(() => {
          btnText.textContent = "Salin Alamat Email";
        }, 2500);
      }
    });
  });
</script>

<style>
  .contact-section {
    padding: 120px 0;
    position: relative;
    background-color: var(--bg-surface);
    border-top: 1px solid var(--border-subtle);
  }

  .contact-card {
    background: var(--bg-card);
    border: 1px solid var(--border-medium);
    border-radius: var(--radius-xl);
    padding: 64px 40px;
    box-shadow: 0 25px 60px rgba(0, 0, 0, 0.5);
    background-image: radial-gradient(circle at 50% 0%, rgba(56, 189, 248, 0.08) 0%, transparent 70%);
  }

  .text-center {
    text-align: center;
  }

  .section-label-tag {
    font-family: var(--font-mono);
    font-size: 0.78125rem;
    font-weight: 600;
    color: var(--accent-cyan);
    letter-spacing: 0.12em;
    display: block;
    margin-bottom: 14px;
  }

  .contact-heading {
    font-size: clamp(1.8rem, 3.5vw, 2.6rem);
    font-weight: 800;
    color: var(--text-primary);
    letter-spacing: -0.02em;
    max-width: 700px;
    margin: 0 auto 16px;
    line-height: 1.25;
  }

  .contact-subtext {
    font-size: 1.05rem;
    color: var(--text-secondary);
    max-width: 580px;
    margin: 0 auto 40px;
    line-height: 1.7;
  }

  .contact-actions {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 16px;
    flex-wrap: wrap;
  }

  .social-button {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 14px 24px;
    border-radius: var(--radius-md);
    font-size: 0.92rem;
    font-weight: 600;
    text-decoration: none;
    transition: var(--transition-fast);
  }

  .email-btn {
    background: rgba(16, 185, 129, 0.1);
    border: 1px solid rgba(16, 185, 129, 0.3);
    color: var(--accent-green);
    cursor: pointer;
    font-family: inherit;
  }

  .email-btn:hover {
    background: rgba(16, 185, 129, 0.2);
    transform: translateY(-2px);
    border-color: var(--accent-green);
  }

  .github-btn {
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid var(--border-medium);
    color: var(--text-primary);
  }

  .github-btn:hover {
    background: rgba(255, 255, 255, 0.1);
    transform: translateY(-2px);
    border-color: rgba(255, 255, 255, 0.3);
  }

  .linkedin-btn {
    background: rgba(10, 102, 194, 0.12);
    border: 1px solid rgba(10, 102, 194, 0.3);
    color: #38bdf8;
  }

  .linkedin-btn:hover {
    background: rgba(10, 102, 194, 0.25);
    transform: translateY(-2px);
    border-color: #38bdf8;
  }

  .cv-highlight-btn {
    background-color: var(--accent-cyan);
    color: #07090e;
    font-weight: 700;
    box-shadow: 0 4px 20px rgba(56, 189, 248, 0.3);
  }

  .cv-highlight-btn:hover {
    background-color: #7dd3fc;
    transform: translateY(-2px);
    box-shadow: 0 8px 30px rgba(56, 189, 248, 0.5);
  }

  @media (max-width: 640px) {
    .contact-card {
      padding: 32px 18px;
    }
    .contact-title {
      font-size: 1.6rem;
    }
    .contact-actions {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 10px;
      width: 100%;
    }
    .social-button {
      justify-content: center;
      width: 100%;
      padding: 12px 10px;
      font-size: 0.82rem;
      gap: 6px;
      text-align: center;
    }
    .social-button svg {
      width: 16px;
      height: 16px;
      flex-shrink: 0;
    }
  }

  @media (max-width: 420px) {
    .contact-card {
      padding: 24px 14px;
    }
    .contact-actions {
      grid-template-columns: repeat(2, 1fr);
      gap: 8px;
    }
    .social-button {
      padding: 10px 6px;
      font-size: 0.75rem;
    }
  }
</style>
