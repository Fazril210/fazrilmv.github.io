---
/**
 * About Section Component
 * Minimalist editorial design highlighting profile, university, key strengths, soft skills & direct CV link.
 */
const softSkills = [
  "Kepemimpinan",
  "Kerja Tim",
  "Manajemen Proyek",
  "Problem Solving",
  "Komunikasi"
];
---

<section class="about-section" id="tentang">
  <div class="container">
    <div class="section-header reveal">
      <span class="section-label-tag">01 / PROFIL & BACKGROUND</span>
      <h2 class="section-heading">Tentang Fazril Mantovani</h2>
    </div>

    <div class="about-grid">
      <!-- Left Column: Biography & Education -->
      <div class="about-main reveal delay-1">
        <div class="bio-card">
          <h3 class="card-subtitle">Latar Belakang & Visi</h3>
          <p class="bio-paragraph">
            Saya adalah seorang <strong>Full Stack Developer</strong> dan mahasiswa Sistem Informasi di <strong>Universitas Bina Insani</strong>. Fokus utama saya adalah merancang dan mengembangkan aplikasi berbisa tinggi yang tidak sekadar menjadi prototipe, melainkan <em>live / production-ready software</em> yang digunakan masyarakat secara berkelanjutan.
          </p>
          <p class="bio-paragraph">
            Pengalaman praktis saya mencakup kepemimpinan proyek dari tahap analisis kebutuhan pengguna, perancangan basis data relational, integrasi API & IoT, hingga deployment pada server Linux (Ubuntu Server). Saya memadukan kecepatan pengembangan modern dengan standar keamanan dan maintainability kode yang ketat.
          </p>
        </div>

        <div class="edu-card">
          <div class="edu-icon">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M22 10v6M2 10l10-5 10 5-10 5z"></path>
              <path d="M6 12v5c3 3 9 3 12 0v-5"></path>
            </svg>
          </div>
          <div class="edu-info">
            <h4 class="edu-degree">S1 Sistem Informasi</h4>
            <p class="edu-institution">Universitas Bina Insani — Kota Bekasi</p>
            <p class="edu-desc">Fokus pada Software Engineering, Manajemen Proyek TI, & Analisis Data.</p>
          </div>
        </div>
      </div>

      <!-- Right Column: Soft Skills & Quick CV Download Box -->
      <div class="about-sidebar reveal delay-2">
        <div class="sidebar-box">
          <h3 class="card-subtitle">Soft Skills & Kapabilitas</h3>
          <div class="soft-skills-container">
            {softSkills.map((skill) => (
              <div class="soft-skill-pill">
                <span class="pill-dot"></span>
                <span>{skill}</span>
              </div>
            ))}
          </div>
        </div>

        <!-- Download CV Card Widget -->
        <div class="cv-widget-card">
          <div class="cv-card-header">
            <div class="pdf-icon">
              <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                <polyline points="14 2 14 8 20 8"></polyline>
                <line x1="16" y1="13" x2="8" y2="13"></line>
                <line x1="16" y1="17" x2="8" y2="17"></line>
                <polyline points="10 9 9 9 8 9"></polyline>
              </svg>
            </div>
            <div>
              <h4 class="cv-card-title">Curriculum Vitae (PDF)</h4>
              <p class="cv-card-sub">Dokumen Resmi Fazril Mantovani</p>
            </div>
          </div>
          <p class="cv-card-desc">
            Dapatkan ringkasan riwayat pendidikan, proyek produksi, keahlian teknis, dan pencapaian kompetisi dalam format PDF.
          </p>
          <a 
            href="${import.meta.env.BASE_URL}CV/CV_Fazril_Mantovani.pdf" 
            target="_blank" 
            download="CV_Fazril_Mantovani.pdf" 
            class="cv-download-button"
          >
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
              <polyline points="7 10 12 15 17 10"></polyline>
              <line x1="12" y1="15" x2="12" y2="3"></line>
            </svg>
            <span>Unduh File CV (PDF)</span>
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .about-section {
    padding: 120px 0;
    position: relative;
    background-color: var(--bg-surface);
    border-top: 1px solid var(--border-subtle);
    border-bottom: 1px solid var(--border-subtle);
  }

  .section-header {
    margin-bottom: 56px;
  }

  .section-label-tag {
    font-family: var(--font-mono);
    font-size: 0.78125rem;
    font-weight: 600;
    color: var(--accent-cyan);
    letter-spacing: 0.12em;
    display: block;
    margin-bottom: 10px;
  }

  .section-heading {
    font-size: clamp(2rem, 4vw, 2.75rem);
    font-weight: 800;
    color: var(--text-primary);
    letter-spacing: -0.02em;
  }

  .about-grid {
    display: grid;
    grid-template-columns: 1.2fr 0.8fr;
    gap: 48px;
  }

  .card-subtitle {
    font-size: 1.15rem;
    font-weight: 700;
    color: var(--text-primary);
    margin-bottom: 20px;
  }

  .bio-card {
    background: var(--bg-card);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-lg);
    padding: 36px;
    margin-bottom: 24px;
  }

  .bio-paragraph {
    font-size: 1.025rem;
    color: var(--text-secondary);
    line-height: 1.8;
    margin-bottom: 16px;
  }

  .bio-paragraph:last-child {
    margin-bottom: 0;
  }

  .bio-paragraph strong {
    color: var(--text-primary);
    font-weight: 600;
  }

  .bio-paragraph em {
    color: var(--accent-cyan);
    font-style: normal;
  }

  .edu-card {
    display: flex;
    gap: 20px;
    background: var(--bg-card);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-lg);
    padding: 28px;
    align-items: flex-start;
  }

  .edu-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 52px;
    height: 52px;
    border-radius: var(--radius-md);
    background: rgba(56, 189, 248, 0.08);
    color: var(--accent-cyan);
    flex-shrink: 0;
    border: 1px solid rgba(56, 189, 248, 0.2);
  }

  .edu-degree {
    font-size: 1.1rem;
    font-weight: 700;
    color: var(--text-primary);
    margin-bottom: 4px;
  }

  .edu-institution {
    font-size: 0.92rem;
    font-weight: 600;
    color: var(--accent-cyan);
    margin-bottom: 6px;
  }

  .edu-desc {
    font-size: 0.875rem;
    color: var(--text-muted);
  }

  /* Sidebar */
  .sidebar-box {
    background: var(--bg-card);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-lg);
    padding: 32px;
    margin-bottom: 24px;
  }

  .soft-skills-container {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  .soft-skill-pill {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 8px 16px;
    border-radius: 100px;
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid var(--border-subtle);
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--text-secondary);
    transition: var(--transition-fast);
  }

  .soft-skill-pill:hover {
    border-color: var(--accent-cyan);
    color: var(--text-primary);
    background: rgba(56, 189, 248, 0.05);
  }

  .pill-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background-color: var(--accent-cyan);
  }

  /* Download CV Widget Card */
  .cv-widget-card {
    background: linear-gradient(135deg, rgba(56, 189, 248, 0.08) 0%, rgba(129, 140, 248, 0.04) 100%);
    border: 1px solid rgba(56, 189, 248, 0.25);
    border-radius: var(--radius-lg);
    padding: 32px;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.3);
  }

  .cv-card-header {
    display: flex;
    align-items: center;
    gap: 16px;
    margin-bottom: 16px;
  }

  .pdf-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 48px;
    height: 48px;
    border-radius: var(--radius-md);
    background: var(--accent-cyan);
    color: #07090e;
    flex-shrink: 0;
  }

  .cv-card-title {
    font-size: 1.05rem;
    font-weight: 700;
    color: var(--text-primary);
  }

  .cv-card-sub {
    font-size: 0.8125rem;
    color: var(--text-muted);
  }

  .cv-card-desc {
    font-size: 0.875rem;
    color: var(--text-secondary);
    line-height: 1.6;
    margin-bottom: 24px;
  }

  .cv-download-button {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    width: 100%;
    padding: 14px 20px;
    border-radius: var(--radius-md);
    background-color: var(--accent-cyan);
    color: #07090e;
    font-weight: 700;
    font-size: 0.92rem;
    text-decoration: none;
    transition: var(--transition-fast);
    box-shadow: 0 4px 15px rgba(56, 189, 248, 0.3);
  }

  .cv-download-button:hover {
    background-color: #7dd3fc;
    transform: translateY(-2px);
    box-shadow: 0 8px 25px rgba(56, 189, 248, 0.5);
  }

  @media (max-width: 960px) {
    .about-grid {
      grid-template-columns: 1fr;
      gap: 32px;
    }
  }

  @media (max-width: 640px) {
    .bio-card, .sidebar-box, .cv-widget-card {
      padding: 20px;
      border-radius: var(--radius-md);
    }
    .edu-card {
      padding: 20px;
      flex-direction: column;
      gap: 14px;
    }
    .bio-paragraph {
      font-size: 0.95rem;
    }
    .soft-skills-container {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 8px;
    }
    .soft-skill-pill {
      font-size: 0.8rem;
      padding: 6px 10px;
      justify-content: center;
    }
  }
</style>
