---
/**
 * Navbar component with direct CV Download button & active section indicator
 */
const navItems = [
  { 
    href: "#tentang", 
    label: "Tentang",
    icon: `<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>`
  },
  { 
    href: "#keahlian", 
    label: "Keahlian",
    icon: `<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="16 18 22 12 16 6"></polyline><polyline points="8 6 2 12 8 18"></polyline></svg>`
  },
  { 
    href: "#proyek", 
    label: "Proyek",
    icon: `<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7"></rect><rect x="14" y="3" width="7" height="7"></rect><rect x="14" y="14" width="7" height="7"></rect><rect x="3" y="14" width="7" height="7"></rect></svg>`
  },
  { 
    href: "#prestasi", 
    label: "Prestasi",
    icon: `<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="8" r="7"></circle><polyline points="8.21 13.89 7 23 12 20 17 23 15.79 13.88"></polyline></svg>`
  },
  { 
    href: "#kontak", 
    label: "Kontak",
    icon: `<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path><polyline points="22,6 12,13 2,6"></polyline></svg>`
  },
];
---

<header class="navbar-header" id="navbar">
  <div class="container navbar-container">
    <a href="#hero" class="brand-logo" aria-label="Fazril Mantovani Home">
      <span class="logo-code">&lt;</span><span class="logo-name">Fazril.M</span><span class="logo-code"> /&gt;</span>
    </a>

    <nav class="nav-menu" id="navMenu">
      <ul class="nav-list">
        {navItems.map((item) => (
          <li>
            <a href={item.href} class="nav-link">
              <Fragment set:html={item.icon} />
              <span>{item.label}</span>
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="nav-actions">
      <a 
        href="https://fazril210.github.io/fazrilmv.github.io/CV/CV_Fazril_Mantovani.pdf" 
        target="_blank" 
        download="CV_Fazril_Mantovani.pdf" 
        class="btn-cv-download"
        title="Unduh Curriculum Vitae (PDF)"
      >
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
          <polyline points="7 10 12 15 17 10"></polyline>
          <line x1="12" y1="15" x2="12" y2="3"></line>
        </svg>
        <span>Unduh CV</span>
      </a>

      <button class="mobile-toggle" id="menuToggle" aria-label="Buka menu navigasi">
        <span class="bar"></span>
        <span class="bar"></span>
        <span class="bar"></span>
      </button>
    </div>
  </div>
</header>

<div class="mobile-drawer" id="mobileDrawer">
  <ul class="mobile-nav-list">
    {navItems.map((item) => (
      <li>
        <a href={item.href} class="mobile-nav-link">
          <Fragment set:html={item.icon} />
          <span>{item.label}</span>
        </a>
      </li>
    ))}
    <li class="mobile-cv-item">
      <a 
        href="https://fazril210.github.io/fazrilmv.github.io/CV/CV_Fazril_Mantovani.pdf" 
        target="_blank" 
        download="CV_Fazril_Mantovani.pdf" 
        class="mobile-cv-btn"
      >
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
          <polyline points="7 10 12 15 17 10"></polyline>
          <line x1="12" y1="15" x2="12" y2="3"></line>
        </svg>
        <span>Unduh CV (PDF)</span>
      </a>
    </li>
  </ul>
</div>

<style>
  .navbar-header {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    z-index: 1000;
    padding: 20px 0;
    transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
    border-bottom: 1px solid transparent;
  }

  /* Floating Morphing Glassbar on Scroll */
  .navbar-header.scrolled {
    top: 12px;
    width: min(92%, 1160px);
    left: 50%;
    transform: translateX(-50%);
    padding: 10px 24px;
    background: rgba(14, 20, 34, 0.85);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border: 1px solid rgba(56, 189, 248, 0.25);
    border-radius: 100px;
    box-shadow: 0 12px 35px rgba(0, 0, 0, 0.6), 0 0 20px rgba(56, 189, 248, 0.1);
  }

  .navbar-container {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
  }

  .brand-logo {
    font-family: var(--font-mono);
    font-size: 1.15rem;
    font-weight: 700;
    color: var(--text-primary);
    text-decoration: none;
    letter-spacing: -0.02em;
    display: flex;
    align-items: center;
    gap: 2px;
  }

  .logo-code {
    color: var(--accent-cyan);
  }

  .nav-list {
    display: flex;
    align-items: center;
    gap: 6px;
    list-style: none;
  }

  .nav-link {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding: 8px 14px;
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--text-secondary);
    text-decoration: none;
    border-radius: var(--radius-sm);
    transition: var(--transition-fast);
  }

  .nav-link svg {
    color: var(--text-muted);
    transition: color 0.15s ease, transform 0.15s ease;
  }

  .nav-link:hover {
    color: var(--text-primary);
  }

  .nav-link:hover svg {
    color: var(--accent-cyan);
    transform: translateY(-1px);
  }

  .nav-link.active {
    color: var(--accent-cyan);
    background: rgba(56, 189, 248, 0.08);
    font-weight: 600;
  }

  .nav-link.active svg {
    color: var(--accent-cyan);
  }

  /* Header action buttons alignment */
  .nav-actions {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .btn-cv-download {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 8px 16px;
    border-radius: var(--radius-sm);
    font-size: 0.84rem;
    font-weight: 600;
    color: #080c14;
    background-color: var(--accent-cyan);
    text-decoration: none;
    transition: var(--transition-fast);
    box-shadow: 0 2px 12px rgba(56, 189, 248, 0.25);
  }

  .btn-cv-download:hover {
    transform: translateY(-2px);
    box-shadow: 0 6px 20px rgba(56, 189, 248, 0.4);
    background-color: #7dd3fc;
  }

  .mobile-toggle {
    display: none;
    flex-direction: column;
    justify-content: space-between;
    width: 28px;
    height: 20px;
    background: none;
    border: none;
    cursor: pointer;
    padding: 0;
    z-index: 1002;
  }

  .mobile-toggle .bar {
    width: 100%;
    height: 2px;
    background-color: var(--text-primary);
    border-radius: 2px;
    transition: transform 0.3s ease, opacity 0.3s ease;
  }

  .mobile-toggle.active .bar:nth-child(1) {
    transform: translateY(9px) rotate(45deg);
  }
  .mobile-toggle.active .bar:nth-child(2) {
    opacity: 0;
  }
  .mobile-toggle.active .bar:nth-child(3) {
    transform: translateY(-9px) rotate(-45deg);
  }

  .mobile-drawer {
    position: fixed;
    inset: 0;
    background: rgba(8, 12, 20, 0.98);
    backdrop-filter: blur(20px);
    z-index: 999;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.3s ease;
    overflow-y: auto;
    padding: 80px 20px 40px;
  }

  .mobile-drawer.active {
    opacity: 1;
    pointer-events: auto;
  }

  .mobile-nav-list {
    list-style: none;
    text-align: center;
    display: flex;
    flex-direction: column;
    gap: 20px;
    width: 85%;
    max-width: 320px;
  }

  .mobile-nav-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    font-size: 1.25rem;
    font-weight: 600;
    color: var(--text-secondary);
    text-decoration: none;
    transition: color 0.2s;
  }

  .mobile-nav-link svg {
    color: var(--accent-cyan);
  }

  .mobile-nav-link:hover {
    color: var(--accent-cyan);
  }

  .mobile-cv-item {
    margin-top: 16px;
  }

  .mobile-cv-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    padding: 14px 24px;
    border-radius: var(--radius-md);
    background-color: var(--accent-cyan);
    color: #080c14;
    font-weight: 700;
    font-size: 1rem;
    text-decoration: none;
  }

  @media (max-width: 820px) {
    .nav-menu {
      display: none;
    }
    .btn-cv-download {
      display: none; /* Hide header download button on mobile since it is inside drawer menu */
    }
    .mobile-toggle {
      display: flex;
    }
    .navbar-header.scrolled {
      width: calc(100% - 24px);
      border-radius: 16px;
      padding: 12px 18px;
    }
  }

  @media (max-width: 480px) {
    .brand-logo {
      font-size: 1.05rem;
    }
  }
</style>

<script>
  const navbar = document.getElementById("navbar");
  const toggle = document.getElementById("menuToggle");
  const drawer = document.getElementById("mobileDrawer");
  const mobileLinks = document.querySelectorAll(".mobile-nav-link, .mobile-cv-btn");
  const navLinks = document.querySelectorAll(".nav-link");
  const sections = document.querySelectorAll("section[id]");

  window.addEventListener("scroll", () => {
    if (window.scrollY > 40) {
      navbar?.classList.add("scrolled");
    } else {
      navbar?.classList.remove("scrolled");
    }

    // Scroll spy active link indicator
    let current = "";
    sections.forEach((section) => {
      const sectionTop = (section as HTMLElement).offsetTop - 120;
      if (window.scrollY >= sectionTop) {
        current = section.getAttribute("id") || "";
      }
    });

    navLinks.forEach((link) => {
      link.classList.remove("active");
      if (link.getAttribute("href") === `#${current}`) {
        link.classList.add("active");
      }
    });
  });

  toggle?.addEventListener("click", () => {
    toggle.classList.toggle("active");
    drawer?.classList.toggle("active");
    if (drawer?.classList.contains("active")) {
      document.body.style.overflow = "hidden";
    } else {
      document.body.style.overflow = "";
    }
  });

  mobileLinks.forEach(link => {
    link.addEventListener("click", () => {
      toggle?.classList.remove("active");
      drawer?.classList.remove("active");
      document.body.style.overflow = "";
    });
  });
</script>
